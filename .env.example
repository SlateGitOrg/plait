# plait reads no .env file itself; these are the environment variables it
# understands. Export them in your shell to use them.

# Log level for structured logs on stderr: debug, info, warn (default), error.
PLAIT_LOG=warn

# Any input variable can be set as PLAIT_VAR_<name>, e.g. for examples/webstack:
PLAIT_VAR_cloud_endpoint=http://127.0.0.1:8787
PLAIT_VAR_web_count=2
